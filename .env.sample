# Copy to .env.local for local development. Commit no populated env files.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workspace_template?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/workspace_template?schema=public"

BETTER_AUTH_SECRET="replace-with-openssl-rand-hex-32"
BETTER_AUTH_URL="http://localhost:3000"

# Required in production: sign-in there is Google-only (ADR 0006). Register
# <BETTER_AUTH_URL>/api/auth/callback/google as an authorised redirect URI.
# Locally, email and password work without these; verification links print
# to the dev server console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails allowed to sign in. Required in production, where an
# empty list admits nobody; locally, empty admits anyone.
AUTH_ALLOWED_EMAILS=""
