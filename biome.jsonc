{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    // Claude worktrees under .claude/ carry their own root biome.jsonc, which
    // Biome rejects as a nested root and aborts the whole check.
    // shadcn/ui components are vendored from the registry; keep them byte-for-byte
    // upstream so `shadcn add --diff` stays readable.
    "includes": ["!!**/.claude", "!packages/ui/src/components"]
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      // Inline handlers are idiomatic React 19; wrapping every one in useCallback
      // adds noise without measurable benefit for this app's component sizes.
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "off"
          }
        }
      }
    }
  ]
}
